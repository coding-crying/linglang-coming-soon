# Browser-visible LiveKit websocket URL, e.g. wss://your-project.livekit.cloud
VITE_LIVEKIT_URL=

# Server-only function credentials
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent worker credentials/provider keys, used outside this website by the LiveKit agent process
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
